# FilmLink Backend API base URL (must include /api/v1)
# - Expo Web (http://localhost:8081 -> http://localhost:8080): kept as-is
# - Android Emulator: automatically resolves localhost -> 10.0.2.2 (or Expo dev hostUri)
# - Real Device (Wi-Fi): automatically resolves localhost -> host LAN IP via Expo dev hostUri
# - Real Device / Emulator (USB): optionally run `adb reverse tcp:8080 tcp:8080`
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
