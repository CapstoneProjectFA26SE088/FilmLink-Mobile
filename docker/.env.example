# FilmLink PostgreSQL + Flyway + Sample Data Docker Environment
# Copy to .env only if you need to override defaults.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=11111111
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Target schema inside POSTGRES_DB (matches BE/FA26SE088-backend/.env)
DB_SCHEMA=filmlink_local
DB_TEST_SCHEMA=filmlink_test

# Host address used by docker-compose.external.yml to reach your already-running Docker Postgres
EXTERNAL_DB_HOST=host.docker.internal

# Read-only path to official Flyway SQL migrations in FA26SE088-backend
BE_MIGRATIONS_DIR=../../BE/FA26SE088-backend/src/main/resources/db/migration

# Where generated sample JPEG/PDF files matching seeded blob_key rows are written.
# Tip: set to ../../BE/FA26SE088-backend/uploads or point BE/.env STORAGE_LOCAL_ROOT here.
SEED_UPLOADS_DIR=./uploads
