        "auth.otp.recipient",
        "auth.otp.expiry",
        "auth.otp.error",
        "auth.otp.sms-fallback",
        "auth.otp.to-login",
        "auth.forgot.screen",
        "auth.forgot.top-back",
        "auth.forgot.brand-mark",
        "auth.forgot.error",
        "auth.forgot.email",
        "auth.forgot.submit",
        "auth.forgot.back",
        "auth.reset.screen",
        "auth.reset.top-back",
        "auth.reset.brand-mark",
        "auth.reset.recipient",
        "auth.reset.error",
        "auth.reset.password",
        "auth.reset.confirm",
        "auth.reset.submit",
        "auth.reset.to-login"
      ],
      "invariants": [
        "UC06: Registration enforces 2-100 char name, valid email, alphanumeric >= 8 char password, and accepted terms",
        "UC06: OTP verification enforces 6 digits and caps failed attempts at 5",
        "BR-01: Newly verified accounts default to PHOTOGRAPHER role"
      ]
    },
    {
      "id": "home",
      "title": "Home Dashboard",
      "route": "/(tabs)",
      "routeFile": "src/app/(tabs)/index.tsx",
      "entry": "src/features/home/ui/HomeScreen.tsx",
      "testIDs": [
        "home.screen",
        "home.toggle-role",
        "home.open-upgrade",
        "home.open-ai",
        "home.open-expert",
        "home.open-orders",
        "home.open-services"
      ],
      "invariants": [
        "Summarizes active vs completed service orders cleanly",
        "Quick-book pre-fills bookingDraft and navigates to Services"
      ]
    },
    {
      "id": "services",
      "title": "Lab Directory & Booking",
      "route": "/(tabs)/services",
      "routeFile": "src/app/(tabs)/services.tsx",
      "entry": "src/features/services/ui/ServicesScreen.tsx",
      "testIDs": [
        "services.screen",
        "services.search",
        "services.empty",
        "services.booking.draft-recovery",
        "services.booking.film-stock",
        "services.booking.rolls-dec",
        "services.booking.rolls-inc",
        "services.booking.stops-dec",
        "services.booking.stops-inc",
        "services.booking.note",
        "services.booking.submit"
      ],
      "invariants": [
        "Filters verified labs by search query, chemical process, and film format",
        "Clamps roll count to [1, 20] and push/pull stops to [-3, 3]"
      ]
    },
    {
      "id": "orders",
      "title": "Orders & Scan Archive",
      "route": "/(tabs)/orders",
      "routeFile": "src/app/(tabs)/orders.tsx",
      "entry": "src/features/orders/ui/OrdersScreen.tsx",
      "testIDs": ["orders.screen", "orders.empty"],
      "invariants": [
        "BR-07: Tracks 6 sequential lab processing stages",
        "BR-08: Exposes digital scan archive and full-res download on completed orders",
        "BR-27 & BR-33: Validates non-empty rescan reasons and supports one review per completed order"
      ]
    },
    {
