        "marketplace.form.brand",
        "marketplace.form.price",
        "marketplace.form.description",
        "marketplace.form.submit"
      ],
      "invariants": [
        "BR-51: Displays lab-verified Condition Report per consignment item",
        "BR-52: Restricts price offers to 60%-100% of listed price and max 3 negotiation rounds"
      ]
