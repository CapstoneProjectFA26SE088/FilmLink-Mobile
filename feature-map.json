        "auth.register.name",
        "auth.register.email",
        "auth.register.phone",
        "auth.register.password",
        "auth.register.terms",
        "auth.register.submit",
        "auth.register.back",
        "auth.register.top-back",
        "auth.register.brand-mark",
        "auth.register.error",
        "auth.register.notice",
        "auth.register.google",
        "auth.register.apple",
        "auth.otp.screen",
        "auth.otp.code",
        "auth.otp.notice",
        "auth.otp.verify",
        "auth.otp.resend",
        "auth.otp.top-back",
